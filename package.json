{
  "name": "nightshift",
  "private": true,
  "version": "0.1.0",
  "description": "Private payroll with public proof, on the Midnight Network",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "5.7.2"
  },
  "overrides": {
    "@midnight-ntwrk/ledger-v8": "8.1.1"
  }
}
