{
  "name": "nightshift",
  "private": true,
  "version": "0.1.0",
  "description": "Private payroll with public proof, on the Midnight Network",
  "type": "module",
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "node scripts/dedupe-wasm.mjs",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev:worker": "npm run dev -w @nightshift/worker-app",
    "dev:employer": "npm run dev -w @nightshift/employer-app",
    "dev:auditor": "npm run dev -w @nightshift/auditor",
    "start:backend": "npm run start:dev -w @nightshift/backend"
  },
  "devDependencies": {
    "@jridgewell/trace-mapping": "^0.3.24",
    "lightningcss-win32-x64-msvc": "^1.33.0",
    "typescript": "5.7.2"
  },
  "overrides": {
    "@midnight-ntwrk/ledger-v8": "8.1.1"
  }
}
