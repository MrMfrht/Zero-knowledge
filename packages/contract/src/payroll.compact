pragma language_version 0.23;

import CompactStandardLibrary;

// ---------------------------------------------------------------------------
// NightShift — private payroll with public proof.
//
// Everything declared `ledger` below is PUBLIC: it lives on-chain and anyone
// in the world can read it. So no salary appears here. What appears instead is
// a commitment — a hash of the salary and a secret random salt — which hides
// the number while making it impossible to change later.
//
// See A_docs/01-understanding-the-contract.md for why any of this is shaped
// the way it is.
// ---------------------------------------------------------------------------

// --- public state ----------------------------------------------------------

/// Who is allowed to hire. Derived from the deployer's secret in the
/// constructor, and `sealed` so no later circuit can ever move it.
export sealed ledger employerKey: Bytes<32>;

/// A random 32 bytes chosen once, when this contract is deployed.
///
/// Its only job is to make identities different in every deployment. Every key
/// on this ledger is the hash of a secret AND this value, so the same person
/// gets a different public key from each employer who runs NightShift. Without
/// it, two employers could compare ledgers and spot a shared worker.
///
/// Public on purpose — the apps must read it to compute their own key. It is a
/// separator, not a secret, and it is `sealed` so identities can never shift
/// underneath the keys already stored.
export sealed ledger deploymentId: Bytes<32>;

/// workerKey -> persistentCommit(ratePerPeriod, salt)
///
/// The VALUES in a Map are public, which is exactly why a commitment goes here
/// and not a salary. Publishing this map tells an observer nothing.
export ledger agreedRate: Map<Bytes<32>, Bytes<32>>;

/// H(workerKey, period) -> hours the employer approved for that period
///
/// Hours are public ON PURPOSE. The employer already knows them, and hours
/// alone reveal nothing about pay — only the rate is sensitive. This is what
/// selective disclosure means in practice: hide exactly what needs hiding.
///
/// Salaried workers use 1, so `1 x rate = rate`. One circuit covers hourly,
/// salaried and fixed-price work.
export ledger approvedHours: Map<Bytes<32>, Uint<32>>;

/// Social-security percentage, e.g. 25 means 25%. Fixed at deployment and
/// public — the law's number, not anyone's secret.
export sealed ledger contributionRate: Uint<8>;

/// H(workerKey, period) -> was the social-security declaration for this period
/// calculated on the worker's REAL earnings? One boolean; the earnings, the
/// rate and the declared amount all stay private.
export ledger contributionOk: Map<Bytes<32>, Boolean>;

/// H(workerKey, period) -> was this period paid correctly?
///
/// The entire public output of the product. One boolean per worker per period.
/// Present and true means the worker proved, in zero knowledge, that the money
/// they received equalled hours x their sealed rate. Absent means they did not.
///
/// No amount appears here, or anywhere else on this ledger.
export ledger paidFor: Map<Bytes<32>, Boolean>;

/// workerKey -> is this person currently employed?
///
/// Three states, deliberately:
///   absent  — the employer has made an offer, the worker has not accepted yet
///   true    — accepted and currently employed
///   false   — employment ended (set by `endEmployment`; history is never deleted)
export ledger active: Map<Bytes<32>, Boolean>;

// --- private input ---------------------------------------------------------

/// The caller's 32-byte secret. Lives on their own device and is never
/// transmitted. Implemented in TypeScript by the `api` package.
witness localSk(): Bytes<32>;

// --- identity --------------------------------------------------------------

/// A caller's public identity: the hash of their secret and this deployment.
///
/// `pure` because it touches no ledger state — callers pass `deploymentId` in.
///
/// Two separators, doing two different jobs. The constant `"nightshift:pk:"`
/// keeps NightShift identities distinct from other apps that hash the same
/// secret. The `deployment` value keeps them distinct from *other NightShift
/// deployments*: one person working for two employers gets an unrelated key in
/// each ledger, so the two employers cannot join their public records and
/// discover a shared worker.
export pure circuit dappKey(sk: Bytes<32>, deployment: Bytes<32>): Bytes<32> {
    return disclose(persistentHash<Vector<3, Bytes<32>>>(
        [pad(32, "nightshift:pk:"), deployment, sk]));
}

/// Seal a rate. Exported so the api computes commitments EXACTLY as the
/// contract checks them — reimplementing this in TypeScript and getting the
/// byte encoding subtly wrong would break acceptHire forever.
export pure circuit sealRate(rate: Uint<64>, salt: Bytes<32>): Bytes<32> {
    return persistentCommit<Uint<64>>(rate, salt);
}

/// One worker, one period — a single key for the `approvedHours` map.
///
/// A `Map` takes one key, but a timesheet is identified by two things. Hashing
/// them together gives one 32-byte value that is unique to the pair.
///
/// The domain separator differs from `dappKey`'s, so a period key can never
/// collide with an identity key.
pure circuit periodKey(worker: Bytes<32>, period: Uint<32>): Bytes<32> {
    return persistentHash<Vector<3, Bytes<32>>>(
        [pad(32, "nightshift:period:"), worker, period as Bytes<32>]);
}
/// This is the answer to your ownPublicKey() question in code. We never ask "who are you?" We compute the hash of your secret and compare. To pass as the employer you'd need a secret whose hash equals employerKey — which means reversing a hash.

// --- deployment ------------------------------------------------------------

/// Whoever deploys the contract becomes the employer, and the social-security
/// percentage is fixed for the contract's whole life.
///
/// `deployment` must be 32 random bytes, freshly generated by the deploying
/// app — never a constant, never copied from another deployment. Reusing one
/// employer's value in another's contract would make the same worker show the
/// same key in both, which is the whole thing this argument prevents.
constructor(contributionPct: Uint<8>, deployment: Bytes<32>) {
    assert(contributionPct <= 100, "contribution rate is a percentage");
    deploymentId = disclose(deployment);
    employerKey = dappKey(localSk(), deployment);
    contributionRate = disclose(contributionPct);
}

// --- circuits --------------------------------------------------------------

/// Seal a worker's agreed rate on-chain.
///
/// The employer computes `persistentCommit(rate, salt)` off-chain and passes
/// only the result. The rate and salt themselves never reach this contract —
/// they go to the worker directly, who checks them in `acceptHire`.
///
/// No funds move. A commitment commits to a *number*, not to money.
export circuit hire(worker: Bytes<32>, rateCommitment: Bytes<32>): [] {
    // Authenticate by proving knowledge of the employer's secret. Never by
    // asking who the caller is — see ownPublicKey() in the explainer.
    assert(dappKey(localSk(), deploymentId) == employerKey, "only the employer may hire");

    const w = disclose(worker);
    assert(!agreedRate.member(w), "this worker already has a sealed rate");

    agreedRate.insert(w, disclose(rateCommitment));
}

/// The worker checks that the sealed rate really is the number they were told,
/// then accepts the job.
///
/// This circuit exists because a commitment is unreadable. The employer could
/// promise 5000 and seal 4000, and the worker would have no way to tell — until
/// payday, when nothing would add up. So before starting work, the worker
/// reproduces the commitment from the rate and salt they were actually given
/// and checks it against what is on-chain.
///
/// A mismatch fails the transaction. The worker finds out on day zero, not on
/// payday.
///
/// Only this worker can call this for themselves: `k` is derived from the
/// caller's own secret, so nobody can accept on anyone else's behalf.
export circuit acceptHire(rate: Uint<64>, salt: Bytes<32>): [] {
    const k = disclose(dappKey(localSk(), deploymentId));
    assert(agreedRate.member(k), "no offer has been made to you");
    assert(!active.member(k), "you have already accepted this offer");

    // The anchor. `rate` and `salt` come from the worker's own machine, so on
    // their own they prove nothing — but only the original pair can reproduce
    // the commitment the employer already published.
    assert(persistentCommit<Uint<64>>(rate, salt) == agreedRate.lookup(k),
           "the sealed rate does not match the rate and salt you were given");

    active.insert(k, true);
}

/// The employer approves a timesheet, which unlocks that period for payment.
///
/// Runs on the EMPLOYER's machine, using the EMPLOYER's secret — unlike
/// `acceptHire`, which runs on the worker's. `localSk()` always means "the
/// secret of whoever is calling right now".
///
/// Hours go on the public ledger deliberately. The employer already knows them,
/// and hours alone say nothing about pay. Pass 1 for salaried workers.
///
/// Approving is a precondition for `confirmPayment`: a worker cannot confirm a
/// period the employer has not signed off.
export circuit approveHours(worker: Bytes<32>, period: Uint<32>, hours: Uint<32>): [] {
    assert(dappKey(localSk(), deploymentId) == employerKey, "only the employer may approve hours");

    const w = disclose(worker);
    assert(active.member(w), "this worker has not accepted an offer");
    assert(active.lookup(w), "this worker's employment has ended");

    const pk = disclose(periodKey(w, period));

    // Write-once, like every other map in this contract. Without this guard
    // the employer could underpay, then quietly re-approve the period with
    // fewer hours before the worker confirms — and confirmPayment would bless
    // the wrong amount, because it trusts approvedHours as its anchor.
    assert(!approvedHours.member(pk), "hours already approved for this period");

    approvedHours.insert(pk, disclose(hours));
}

/// The worker proves the money that arrived was exactly what was agreed.
///
/// THIS IS THE PRODUCT. Everything else exists to make this circuit possible.
///
/// Runs on the WORKER's machine, with the WORKER's secret. Three private
/// numbers go in — the rate, the salt and the amount received — and exactly one
/// public fact comes out: this period was paid correctly. None of the three
/// ever reaches the ledger.
///
/// Note what is NOT an argument: `hours`. It is read from the ledger, where the
/// employer put it. The worker cannot claim to have worked more hours than were
/// approved, because they never get to supply that number at all.
///
/// The failure case is the demo. If the employer sent 4000 when 5000 was
/// agreed, the last assertion fails, no proof can be produced, and the period
/// stays permanently unconfirmed on a public ledger — while the salary itself
/// stays unreadable to everyone on earth.
export circuit confirmPayment(
    period: Uint<32>,
    rate: Uint<64>,
    salt: Bytes<32>,
    amountReceived: Uint<64>
): [] {
    const k = disclose(dappKey(localSk(), deploymentId));
    assert(active.member(k), "you have not accepted an offer");
    assert(active.lookup(k), "your employment has ended");

    const pk = disclose(periodKey(k, period));
    assert(approvedHours.member(pk), "the employer has not approved hours for this period yet");
    assert(!paidFor.member(pk), "this period is already confirmed");

    // Anchor 1: this really is the rate sealed at hiring. Without this the
    // check below would be worthless — the worker picks both numbers, so of
    // course they would agree with each other.
    assert(persistentCommit<Uint<64>>(rate, salt) == agreedRate.lookup(k),
           "that is not your agreed rate");

    // Anchor 2: the hours the EMPLOYER approved, not any the worker supplied.
    const hours = approvedHours.lookup(pk);

    // The check the whole product is built on. Comparing a product is safe —
    // Compact widens it rather than wrapping, so there is no overflow to
    // exploit. Storing it would be a compile error. See A_docs/04.
    assert(amountReceived == (hours as Uint<64>) * rate, "incorrect payment");

    paidFor.insert(pk, true);
}

/// The worker proves the social-security declaration was calculated on their
/// REAL earnings — without revealing the earnings, the rate, or the declaration.
///
/// The fraud this closes: the employer pays 5000 but declares 3000 to the fund,
/// pocketing the difference in contributions. Today the worker sees a payslip
/// deduction and has no way to check what was actually reported — until a
/// pension claim fails, decades later.
///
/// Runs on the WORKER's machine. The check is
///     declared == earnings x contributionRate / 100
/// written as a cross-multiplication because Compact has no division operator
/// (verified by compiling — see A_docs/04):
///     declared x 100 == hours x rate x contributionRate
///
/// `declared` stays private on purpose: contributionRate is public, so
/// publishing `declared` would let anyone compute the rate from it.
export circuit proveContribution(
    period: Uint<32>,
    rate: Uint<64>,
    salt: Bytes<32>,
    declared: Uint<64>
): [] {
    const k = disclose(dappKey(localSk(), deploymentId));
    assert(active.member(k), "you have not accepted an offer");

    const pk = disclose(periodKey(k, period));
    assert(approvedHours.member(pk), "no approved hours for this period");
    assert(!contributionOk.member(pk), "this period's contribution is already proven");

    // Same anchor as confirmPayment: the rate must open the seal from hiring.
    assert(persistentCommit<Uint<64>>(rate, salt) == agreedRate.lookup(k),
           "that is not your agreed rate");

    const hours = approvedHours.lookup(pk);
    assert(declared * 100 ==
               (hours as Uint<64>) * rate * (contributionRate as Uint<64>),
           "the declaration does not match your real earnings");

    contributionOk.insert(pk, true);
}

/// The employer marks a worker as no longer employed.
///
/// Nothing is deleted — that is the point. The worker's confirmed periods stay
/// on the public record forever; their last confirmed period becomes their
/// leaving date. What ends is the ability to add new periods: approveHours and
/// confirmPayment both check `active` and will refuse from now on.
export circuit endEmployment(worker: Bytes<32>): [] {
    assert(dappKey(localSk(), deploymentId) == employerKey, "only the employer may end employment");

    const w = disclose(worker);
    assert(active.member(w), "this worker never accepted an offer");
    assert(active.lookup(w), "this worker's employment has already ended");

    active.insert(w, false);
}
