# Point this app at a deployed contract. Copy to .env.local and fill in the
# address printed by `npx tsx src/midnight/deploy.ts` in packages/api.
#
# Leave VITE_CONTRACT_ADDRESS unset (or delete this file) to run on the
# in-memory mock instead. Which one is active is shown in the app's header.
VITE_CONTRACT_ADDRESS=
VITE_NETWORK_ID=undeployed
